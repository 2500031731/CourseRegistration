import React, { useState } from "react";
import VoteButton from "./VoteButton";
import Result from "./Result";

function App() {
  const [votes, setVotes] = useState(0);

  function vote() {
    setVotes(votes + 1);
  }

  return (
    <div>
      <h1>Voting App</h1>
      <VoteButton vote={vote} />
      <Result votes={votes} />
      
    </div>
  );
}

